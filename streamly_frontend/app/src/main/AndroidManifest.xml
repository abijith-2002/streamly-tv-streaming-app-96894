<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV-specific feature declarations -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Streamly"
        android:banner="@drawable/banner_tv">

        <!-- SplashActivity as launcher -->
        <activity
            android:name="com.streamly.tv.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Streamly.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main activity (home) -->
        <activity
            android:name="com.streamly.tv.MainActivity"
            android:exported="false" />
    </application>
</manifest>
