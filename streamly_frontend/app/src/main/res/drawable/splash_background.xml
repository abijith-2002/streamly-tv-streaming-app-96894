<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded splash window background drawable.
  Drawn immediately on window creation for first-frame visibility.
  - Background: #121212
  - Centered "Streamly" wordmark vector
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSplashBackground" />
        </shape>
    </item>

    <!-- Centered vector containing the wordmark -->
    <item
        android:gravity="center"
        android:drawable="@drawable/splash_wordmark" />

</layer-list>
