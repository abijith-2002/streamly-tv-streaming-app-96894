<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent container so that the Activity's windowBackground (splash_background with wordmark)
  remains visible for the entire splash duration. We intentionally avoid adding any opaque views
  here to prevent clearing the background prematurely.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent" />
