<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme for Streamly -->
    <style name="Theme.Streamly" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:statusBarColor">@color/colorSplashBackground</item>
        <item name="android:navigationBarColor">@color/colorSplashBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorSecondary</item>
    </style>

    <!-- Splash screen theme for Android 12+ and fallback -->
    <style name="Theme.Streamly.Splash" parent="Theme.SplashScreen">
        <!-- Background of the splash (Android 12+ API field) -->
        <item name="windowSplashScreenBackground">@color/colorSplashBackground</item>
        <!-- Keep same background for post-splash until content drawn -->
        <item name="postSplashScreenTheme">@style/Theme.Streamly</item>
        <!-- Ensure an immediate, branded background with centered art is visible from the first frame -->
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
