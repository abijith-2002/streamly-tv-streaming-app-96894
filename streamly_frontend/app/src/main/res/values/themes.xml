<resources>
    <!-- Simple base app theme without external libraries -->
    <style name="Theme.Streamly" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Splash theme uses the same background; no Android 12 SplashScreen attrs to avoid missing dependencies -->
    <style name="Theme.Streamly.Splash" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
